rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'ADMIN';
    }

    function isSupervisor() {
      return isAuthenticated() && request.auth.token.role == 'SUPERVISOR';
    }

    function isRep() {
      return isAuthenticated() && request.auth.token.role == 'REP';
    }

    function isAdminOrSupervisor() {
      return isAdmin() || isSupervisor();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the authenticated user has access to a specific region
    function hasRegionAccess(regionNo) {
      return isAuthenticated()
        && request.auth.token.allowedRegionNos is list
        && regionNo in request.auth.token.allowedRegionNos;
    }

    // Check if supervisor has branch access
    function hasBranchAccess(branchId) {
      return isAdmin() || (isSupervisor() && request.auth.token.branchId == branchId);
    }

    // ============================================================
    // DEFAULT DENY — all paths not explicitly matched are blocked
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ============================================================
    // USERS COLLECTION
    // ============================================================
    match /users/{userId} {
      // Admin: full read access
      // Supervisor: read users within same branch
      // Rep: read only own document
      allow read: if isAdmin()
        || (isSupervisor() && resource.data.branchId == request.auth.token.branchId)
        || isOwner(userId);

      // Only Cloud Functions should create/update users
      // Allow self-update for limited fields only (fcmToken, language preference)
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['fcmToken', 'fcmTokenUpdatedAt', 'preferredLanguage']);

      // Admin can create/delete via Cloud Functions
      // Direct client create/delete is denied — use Cloud Functions
      allow create, delete: if false;
    }

    // ============================================================
    // BRANCHES COLLECTION
    // ============================================================
    match /branches/{branchId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================================
    // REGIONS COLLECTION
    // ============================================================
    match /regions/{regionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================================
    // REQUESTS COLLECTION
    // ============================================================
    match /requests/{requestId} {
      // Admin: full access
      // Supervisor: read requests within branch scope
      // Rep: read only Published/Closed/Archived requests that have assignments for this user
      allow read: if isAdmin()
        || (isSupervisor() && hasBranchAccess(resource.data.get('branchId', '')))
        || (isRep()
            && resource.data.status in ['Published', 'Closed', 'Archived']
            && resource.data.get('assignedUserId', '') == request.auth.uid);

      // Only Admin/Cloud Functions can write requests
      allow create, update: if false;
      allow delete: if false; // Never delete — use archive
    }

    // ============================================================
    // REQUEST FIELDS (top-level collection)
    // ============================================================
    match /request_fields/{fieldId} {
      // Any authenticated user can read fields (needed to render forms)
      allow read: if isAuthenticated();

      // Only Admin can modify fields
      allow write: if false;
    }

    // ============================================================
    // REQUEST FIELDS (subcollection variant)
    // ============================================================
    match /requests/{requestId}/fields/{fieldId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ============================================================
    // REQUEST TEMPLATES
    // ============================================================
    match /requestTemplates/{templateId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ============================================================
    // ASSIGNMENTS COLLECTION
    // ============================================================
    match /assignments/{assignmentId} {
      // Admin: full read
      // Supervisor: read assignments within branch
      // Rep: read only own assignments
      allow read: if isAdmin()
        || (isSupervisor() && hasBranchAccess(resource.data.get('branchId', '')))
        || (isRep() && resource.data.userId == request.auth.uid);

      // Only Cloud Functions create/update assignments
      allow write: if isAdmin();
    }

    // ============================================================
    // RECORDS COLLECTION
    // ============================================================
    match /records/{recordId} {
      // Admin: full read
      // Supervisor: read records within branch scope
      // Rep: read only records assigned to authenticated user
      allow read: if isAdmin()
        || (isSupervisor() && hasBranchAccess(resource.data.get('branchId', '')))
        || (isRep() && resource.data.assignedUserId == request.auth.uid);

      // Rep can update own records with limited fields (status, draft/submit)
      allow update: if isRep()
        && resource.data.assignedUserId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly([
             'recordStatus', 'completionPercent',
             'startedAt', 'draftSavedAt', 'submittedAt', 'completedAt',
             'lastSavedAt', 'lastSavedBy', 'updatedAt'
           ]);

      // Admin can update any record
      allow update: if isAdmin();

      // Only Cloud Functions create records (via import)
      allow create: if isAdmin();
      allow delete: if false;
    }

    // ============================================================
    // RESPONSES COLLECTION
    // ============================================================
    match /responses/{responseId} {
      // Admin: full read
      // Supervisor: read within branch scope
      // Rep: read only own submitted responses
      allow read: if isAdmin()
        || (isSupervisor()
            && hasBranchAccess(resource.data.get('branchId', '')))
        || (isRep() && resource.data.submittedBy == request.auth.uid);

      // Rep can create/update responses only for own assigned records
      allow create: if isRep()
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.recordId is string
        && request.resource.data.requestId is string
        && exists(/databases/$(database)/documents/records/$(request.resource.data.recordId))
        && get(/databases/$(database)/documents/records/$(request.resource.data.recordId)).data.assignedUserId == request.auth.uid
        && get(/databases/$(database)/documents/records/$(request.resource.data.recordId)).data.requestId == request.resource.data.requestId;

      allow update: if isRep()
        && resource.data.submittedBy == request.auth.uid
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.recordId == resource.data.recordId
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['data', 'updatedAt', 'submittedAt', 'completionPercent']);

      // Admin can also write responses (for corrections)
      allow create, update: if false;

      allow delete: if false;
    }

    // ============================================================
    // IMPORTS COLLECTION
    // ============================================================
    match /imports/{importId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ============================================================
    // NOTIFICATIONS COLLECTION
    // ============================================================
    match /notifications/{notificationId} {
      // User can read own notifications
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);

      // User can mark own notification as read
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'readAt']);

      // Only Cloud Functions create notifications
      allow create: if isAdmin();
      allow delete: if false;
    }

    // ============================================================
    // DEVICE BINDINGS COLLECTION
    // ============================================================
    match /deviceBindings/{bindingId} {
      // Admin can read all device bindings
      // User can read own bindings
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);

      // Only Cloud Functions manage device bindings
      allow write: if false;
    }

    // ============================================================
    // PASSWORD RESET REQUESTS
    // ============================================================
    match /passwordResetRequests/{resetId} {
      // Admin can read all
      allow read: if isAdmin();

      // Anyone can create (from login screen via Cloud Function)
      // But actual creation goes through Cloud Function, so deny direct client write
      allow write: if false;
    }

    // ============================================================
    // AUDIT LOGS — Immutable append-only
    // ============================================================
    match /auditLogs/{logId} {
      // Only Admin can read audit logs
      allow read: if isAdmin();

      // Only Cloud Functions can create audit logs
      // (Changed from previous rule that allowed authenticated create)
      allow create: if false;

      // Never allow update or delete — audit logs are immutable
      allow update, delete: if false;
    }

    // ============================================================
    // APP SETTINGS
    // ============================================================
    match /appSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================================
    // TRANSLATION TEMPLATES
    // ============================================================
    match /translationTemplates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
