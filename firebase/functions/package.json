{
  "name": "sales-collection-hub-functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc && node scripts/generate-manifest.js",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest --config jest.config.js",
    "test:rules": "jest --config jest.config.js --runInBand --runTestsByPath src/__tests__/firestore.rules.test.ts"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^7.4.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^30.0.0",
    "@types/uuid": "^10.0.0",
    "firebase": "^10.14.1",
    "firebase-functions-test": "^3.1.0",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5.5.0"
  },
  "private": true
}
