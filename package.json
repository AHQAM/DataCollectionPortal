    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
