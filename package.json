    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.103.2",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^18.0.2",
    "firebase": "^12.19.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "vite": "^8.3.0",
